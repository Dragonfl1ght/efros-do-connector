# Пример внешней конфигурации коннектора.
#
# Скопировать в config/application.yml рядом с jar (или примонтировать каталог
# в /app/config внутрь контейнера) и подставить свои значения. Spring Boot подхватывает
# этот файл автоматически и перекрывает им настройки из jar — пересобирать ничего не нужно.
#
# Любую настройку можно задать и переменной окружения. Имя получается из имени настройки:
# верхний регистр, точки и дефисы заменяются на подчёркивания. Например
# connector.edo.base-url -> CONNECTOR_EDO_BASE_URL, server.port -> SERVER_PORT.
# Приоритет: переменная окружения > этот файл > значение по умолчанию из jar.
#
# Без base-url, login, password для EDO и url для e4 коннектор не стартует
# и пишет в лог, какой именно настройки не хватает.

server:
  # Порт, на котором коннектор слушает запросы Менеджера задач.
  port: 8080

connector:

  # Efros Defense Operations — откуда забираем объекты защиты.
  edo:
    # Адрес стенда EDO без хвостового слеша. Обязательно.
    base-url: https://10.116.41.37
    # Учётная запись EDO. Обязательно.
    # Пароль надёжнее передавать переменной CONNECTOR_EDO_PASSWORD, а не хранить в файле.
    login: superadmin
    password: ""
    # Таймауты HTTP.
    connect-timeout: 5s
    read-timeout: 30s

  # Адаптер ePlat4m — куда отправляем технические средства.
  e4:
    # Полный URL эндпоинта импорта. Обязательно.
    url: https://10.10.18.174/api/v1/import/Hardware
    # Учётная запись адаптера. Если оставить пустыми, заголовок авторизации
    # не отправляется вообще.
    login: ""
    password: ""
    # Таймауты HTTP.
    connect-timeout: 5s
    read-timeout: 30s

logging:
  level:
    # DEBUG показывает каждый HTTP-вызов к EDO и e4.
    ru.company.connector.efrosdo: INFO
